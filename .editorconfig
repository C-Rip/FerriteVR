# http://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{toml,yaml,yml,json}]
indent_size = 2

[*.sh]
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{c,cpp,cc,cxx,h,hpp,hxx}]
indent_size = 4

[Makefile]
indent_style = tab
